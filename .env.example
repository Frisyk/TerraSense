# ----------------------------------------------------
# Database Connection (Supabase PostGIS)
# ----------------------------------------------------
# Supabase Connection Pooler (Session Mode) - IPv4 & IPv6 Compatible
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
POSTGRES_PORT=5432
POSTGRES_USER=postgres.your_project_ref
POSTGRES_PASSWORD=your_supabase_password
POSTGRES_DB=postgres

# Geonode DB aliases (used by backend and scripts)
GEONODE_DB_HOST=aws-0-ap-south-1.pooler.supabase.com
GEONODE_DB_PORT=5432
GEONODE_DB_USER=postgres.your_project_ref
GEONODE_DB_PASSWORD=your_supabase_password
GEONODE_DB_NAME=postgres

# Direct DATABASE_URL for SQLAlchemy / asyncpg / node-postgres
DATABASE_URL=postgresql://postgres.your_project_ref:your_supabase_password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# (Direct Host reference - requires IPv6 network)
# SUPABASE_DIRECT_HOST=db.your_project_ref.supabase.co
# SUPABASE_DIRECT_USER=postgres

# ----------------------------------------------------
# Local Docker Container Settings (Fallback / Offline)
# ----------------------------------------------------
LOCAL_POSTGRES_PORT=5434
DB_CONTAINER_NAME=fire_postgis_db

# ----------------------------------------------------
# API Credentials
# ----------------------------------------------------
FIRMS_MAP_KEY=your_firms_map_key
CARTO_API_KEY=your_carto_api_key
NEXT_PUBLIC_CARTO_API_KEY=your_carto_api_key
